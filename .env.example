# Uygulama
APP_NAME=SahteMi
APP_ENV=development
LOG_LEVEL=INFO

# Veritabani (Docker Compose ile uyumlu)
DATABASE_URL=postgresql+asyncpg://sahtemi:sahtemi_dev@localhost:5432/sahtemi

# LLM Saglayici (OpenAI uyumlu istemci - DeepSeek veya OpenAI tek ayarla degisir)
# DeepSeek icin: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# OpenAI icin:   LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Tehdit Istihbarati (Opsiyonel - Faz 1 Hafta 2)
GOOGLE_SAFE_BROWSING_API_KEY=

# Telegram Botu (Faz 1 Hafta 2)
TELEGRAM_BOT_TOKEN=
